Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Confirmed historical URLs: redirect directly to their canonical replacements.
    RewriteRule ^dining/te-akau-roa-menu/?$ https://www.oceansresorthotel.co.nz/dining [R=301,L,NE]
    RewriteRule ^contact-us/?$ https://www.oceansresorthotel.co.nz/contact [R=301,L,NE]
    RewriteCond %{QUERY_STRING} !^$
    RewriteRule ^rooms/king-room-with-marina-view/?$ https://www.oceansresorthotel.co.nz/rooms?%{QUERY_STRING}#deluxe-marina-view [R=301,L,NE]
    RewriteRule ^rooms/king-room-with-marina-view/?$ https://www.oceansresorthotel.co.nz/rooms#deluxe-marina-view [R=301,L,NE]
    RewriteRule ^about/tutukaka-attractions/?$ https://www.oceansresorthotel.co.nz/activities [R=301,L,NE]
    RewriteRule ^amenities/?$ https://www.oceansresorthotel.co.nz/about [R=301,L,NE]
    RewriteRule ^en-gb/dining/?$ https://www.oceansresorthotel.co.nz/dining [R=301,L,NE]
    RewriteCond %{QUERY_STRING} !^$
    RewriteRule ^rooms/king-room-with-balcony-and-marina-view/?$ https://www.oceansresorthotel.co.nz/rooms?%{QUERY_STRING}#deluxe-marina-balcony [R=301,L,NE]
    RewriteRule ^rooms/king-room-with-balcony-and-marina-view/?$ https://www.oceansresorthotel.co.nz/rooms#deluxe-marina-balcony [R=301,L,NE]
    RewriteRule ^about/ocean-resort-hotel/?$ https://www.oceansresorthotel.co.nz/about [R=301,L,NE]

    # Normalise public page variants AND host/protocol in one hop.
    # THE_REQUEST prevents a second redirect after an internal file rewrite.
    # Existing query strings (enquiry preselection / permanent TV QR) survive.
    RewriteCond %{THE_REQUEST} \s/+[^?\s]*(?:/|/index\.html)[?\s] [NC]
    RewriteRule ^(about|rooms|dining|activities|gallery|conference|reviews|contact|gift-vouchers|events|past-events|privacy-policy|pasta-don|art|terry-walsh|wai-i-kukawaka|compendium)(?:/+|/index\.html)$ https://www.oceansresorthotel.co.nz/$1 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
    RewriteRule ^index\.html$ https://www.oceansresorthotel.co.nz/ [R=301,L,NE]

    # The hosting load balancer terminates TLS and supplies env HTTPS.
    # Use the provider's exact lowercase env lookup, not Apache's TLS flag.
    # Do not set this from untrusted forwarded headers in .htaccess.
    RewriteCond %{env:HTTPS} !^on$ [NC,OR]
    RewriteCond %{HTTP_HOST} !^www\.oceansresorthotel\.co\.nz$ [NC]
    RewriteRule ^ https://www.oceansresorthotel.co.nz%{REQUEST_URI} [R=301,L,NE]

    # Direct requests to the error document also have a real 404 status.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^404\.html$ - [R=404,L]

    # Explicit public routes only: no SPA catch-all and no soft 404s.
    RewriteRule ^(about|rooms|dining|activities|gallery|conference|reviews|contact|gift-vouchers|events|past-events|privacy-policy|pasta-don|art|terry-walsh|wai-i-kukawaka|compendium)$ $1/index.html [END]
</IfModule>
